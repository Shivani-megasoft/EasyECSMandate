<script type="text/javascript">

    //shyamal01012025
    $("#txtpassword").on("change", function () {
        debugger
        // FailurePopup("asd");
        debugger;
        var key = CryptoJS.enc.Utf8.parse('8080808080808080');
        var iv = CryptoJS.enc.Utf8.parse('8080808080808080');

        var encryptedpassword = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse($(this).val()), key,
            {
                keySize: 128 / 8,
                iv: iv,
                mode: CryptoJS.mode.CBC,
                padding: CryptoJS.pad.Pkcs7
            });
        $("#txtpassword").val(encryptedpassword);
    });

    $("#txtBrnCd").on("change", function () {
        console.log("sdsfsdf");
        $(this).val(pad($(this).val(), 4));

    });

    function pad(str, max) {
        str = str.toString();
        return str.length < max ? pad("0" + str, max) : str;

    }

    $("#btnLogin").click(function () {
        window.location.href = '@Url.Action("LoginUser", "Account")';
    });

    $(function () {
        $("input[type=password]").attr("autocomplete", "off");
        $("form").attr("autocomplete", "off");
        EnterKey();

        $('input[type=password]').keypress(function (e) {
            var s = String.fromCharCode(e.which);

            if ((s.toUpperCase() === s && s.toLowerCase() !== s && !e.shiftKey) ||
                  (s.toUpperCase() !== s && s.toLowerCase() === s && e.shiftKey)) {
                if ($('#capsalert').length < 1) $(this).after('<b id="capsalert" class="error"></br>CapsLock is on!</b>');
                // $("#error").html("CapsLock is on!");
            } else {
                if ($('#capsalert').length > 0) $('#capsalert').remove();
                // $("#error").html("");
            }
        });
    });

</script>

<script type="text/javascript">
    window.addEventListener('popstate', function (e) {
        //console.log(e.state.url);
        if (null != e.state && null != e.state.url) {
            var url = e.state.url.replace(/^.*\/\/[^\/]+\//, '');
            //console.log(url);
            var n = url.lastIndexOf("/");
            url = url.substr(n + 1);
            //console.log(url);
            $(".data-entry").enter2tab();
            eval(url + '.Initialize()');
        }
    });

    function ReloadCaptchaCode() {

        var url = "/Account/ReloadCaptcha/";
        //  $('#divCaptcha').html("Loading Captcha....");
        $.ajax({
            type: "POST",
            url: url,
            dataType: "json",
            success: function (data) {
                $("#imag").attr('src', data.Item);
                $('#Captcha').val("");
            },
            error: function (reponse) {
                FailurePopup("There was an error while generating captcha. Please refresh the page and try again..!");
            }

        });
    }


    //for key press Enter
    $(function () {
        EnterKey();
    });

    function EnterKey() {
        $("input,select,textarea,password").keydown(function (event) {
            if (event.keyCode == 13) {
                textboxes = $("input,select,textarea,password");
                currentBoxNumber = textboxes.index(this);
                if (textboxes[currentBoxNumber + 1] != null) {
                    if (textboxes[currentBoxNumber + 1].disabled) {
                        nextBox = textboxes[currentBoxNumber + 2];
                    }
                    else {
                        nextBox = textboxes[currentBoxNumber + 1];
                    }
                    nextBox.focus();
                    nextBox.select();
                    event.preventDefault();
                    return true;
                }

                else if ($("#txtBrnCd").val().length == 0) {
                    $("#txtBrnCd").focus(); return false;
                }
                else if ($("#txtLoginId").val().length == 0) {
                    $("#txtLoginId").focus(); return false;
                }
                else if ($("#txtpassword").val().length == 0) {
                    $("#txtpassword").focus(); return false;
                }
                else {
                    return true;
                }

            }
        });
    }
</script>