    //To show success message in popup
    function PopupSuccess(content, isSave) {
        alert(content);
        //$.bigBox({

        //    title: "Success Message:",
        //    content: content,
        //    color: "#739E73",
        //    icon: "fa fa-check",
        //    //number: "4",
        //    timeout: isSave
        //});
    }


    //for key press Enter
    $(function () {
        EnterKey();
    });

    function EnterKey() {
        $("input,select,textarea").keydown(function (event) {
            if (event.keyCode == 13) {
                textboxes = $("input,select,textarea");
                currentBoxNumber = textboxes.index(this);
                if (textboxes[currentBoxNumber + 1] != null) {

                    if (textboxes[currentBoxNumber + 1].disabled) {
                        nextBox = textboxes[currentBoxNumber + 3];
                    }
                    else {
                        nextBox = textboxes[currentBoxNumber + 1];
                    }
                    // nextBox = textboxes[currentBoxNumber + 1];
                    nextBox.focus();
                    nextBox.select();
                    // event.preventDefault();
                    return true;
                }
                event.preventDefault();
                return false;
            }
        });
    }



    //Function to Pad
    function stringPad(i, l, s) {
        var o = i.toString();
        while (o.length < l) {
            o = s + o;
        }
        return o;
    }

    //for Loading ico
    $body = $("body");

    $(document).on({
        ajaxStart: function () { $body.addClass("loading"); },
        ajaxStop: function () { $body.removeClass("loading"); },
        beforeSend: function () { $body.addClass("loading"); },
        complete: function () { $body.removeClass("loading"); }
    });

    $Menu.on('click', function () {
        //$body.addClass("loading");
    });

    //To reset all form controls
    function Reset(form) {
        $(form).trigger('reset');
    }

    //for selection all focus text box
    $(document).ready(function () {
        $("input:text").focus(function () { $(this).select(); });
    });




    jQuery.fn.panno = function () {
        $(this).mask("aaaaa9999a", { placeholder: "" });
    }

    jQuery.fn.ifsccode = function () {
        //$(this).mask("aaaa99", { placeholder: "" });
    }

    jQuery.fn.numeric = function () {
        $(this).autoNumeric({ aPad: false, wEmpty: 'zero', aSep: '', mDec: '0' });
    }

    jQuery.fn.mobileno = function () {
        $(this).autoNumeric({ aPad: false, wEmpty: 'empty', aSep: '', vMax: '9999999999' });
    }

    jQuery.fn.adharcardno = function () {
        $(this).autoNumeric({ aPad: false, wEmpty: 'empty', aSep: '', vMax: '999999999999' });
    }


</script>
