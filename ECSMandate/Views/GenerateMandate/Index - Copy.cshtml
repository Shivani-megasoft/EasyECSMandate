                                </td>
                                <td style="width:150px;padding-left:10px">
                                    @Html.TextBox("CrAcNo", "", new { @id = "CrAcNo", @class = "form-control input-sm", @placeholder = "Account No", @style = "width:150px", @maxlength = 7 })
                                </td>
                                <td style="padding-left:10px">
                                    @Html.TextBox("CrName", "", new { @id = "CrName", @class = "form-control input-sm", @placeholder = "Name", @disabled = "disabled", @style = "background-color:#eef0a2;color:#416c32;font-weight:bold" })
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="col-lg-5">
                    <table>
                        <tr>
                            <td style="width:90px">
                                <label>Mobile No &nbsp; &nbsp; </label>
                            </td>
                            <td>
                                <div class="editor-field">
                                    @Html.TextBox("Mobile", "", new { @id = "Mobile", @style = "width:150px", @class = "form-control input-sm", @maxlength = 10, @minlength = 10 })
