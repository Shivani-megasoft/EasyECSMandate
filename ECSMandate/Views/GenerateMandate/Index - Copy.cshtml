                        </tr>
                    </table>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-lg-12">
                    <table>
                        <tr>
                            <td style="width:123px">
                                <label>
                                    UMR Date
                                </label>
                            </td>
                            <td style="width:65px">
                                @Html.TextBox("UMRDt", "", "{0:dd/MM/yyyy}", new { @id = "UMRDt", @class = "form-control input-sm date", @style = "width:142px" })
                            </td>

                            <td style="padding-left:10px; width:163px">
                                <label>
                                    Installment Date
                                </label>
                            </td>
                            <td class="editor-field">
                                @Html.TextBox("ExecDt", "", "{0:dd/MM/yyyy}", new { @id = "ExecDt", @class = "form-control input-sm date", @style = "width: 150px;" })
                            </td>

                            <td style="padding-left: 10px; width:150px">
                                <label>
                                    Debitor IFSC
                                </label>
                            </td>

                            <td style="padding-left:10px">
                                @Html.TextBox("BnkCd", "", new { @id = "BnkCd", @class = "form-control input-sm", @style = "width:110px;text-transform:uppercase", @maxlength = 11 })
                            </td>
                            <td colspan="2" style="padding-left:10px; width:305px">
                                @Html.TextBox("BankName", "", new { @id = "BankName", @class = "form-control input-sm", @readonly = "readonly", @style = "width:390px;text-transform:uppercase", @maxlength = 30 })
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-lg-12">
                    <table>
                        <tr>
                            <td style="width:120px">
                                <label>
                                    Frequency
                                </label>
                            </td>
                            <td>
                                <div class="editor-field">
                                    @Html.DropDownList("Freq", new SelectList(ViewBag.FrqList, "Key", "Value"), new { @id = "Freq", @class = "form-control input-sm", @style = "width:145px" })<i></i>
                                </div>
                            </td>
                            <td style="padding-left:10px; width:165px">
                                <label>
                                    Debitor Name
                                </label>
                            </td>
                            <td>
                                <div class="editor-field">
                                    @Html.TextBox("DebtrName", "", new { @id = "DebtrName", @class = "form-control input-sm", @style = "width:150px;text-transform:uppercase" })
                                </div>
                            </td>
                            <td style="padding-left:10px; width:155px">
                                <label>
                                    Sequence
                                </label>
                            </td>
                            <td>
                                <div class="editor-field">
                                    @Html.DropDownList("Seq", new SelectList(ViewBag.seqList, "Key", "Value"), new { @id = "Seq", @class = "form-control input-sm", @style = "width:110px" })<i></i>
                                </div>
                            </td>
                            <td style="padding-left: 10px; width: 80px">
                                <label>
                                    Debit Typ
                                </label>
                            </td>
                            <td>
                                <div class="editor-field">
                                    @Html.DropDownList("DebitTyp", new SelectList(ViewBag.DrTypList, "Key", "Value"), new { @id = "DebitTyp", @class = "form-control input-sm", @style = "width:100px" })<i></i>
                                </div>
                            </td>
                            <td style="padding-left:10px; width:80px">
                                <label>
                                    Category
                                </label>
                            </td>
                            <td>
                                <div class="editor-field">
                                    @Html.DropDownList("Category", new SelectList(ViewBag.CategoryList, "CatCode", "Descrp"), new { @id = "Category", @class = "form-control input-sm", @style = "width:143px" })<i></i>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-lg-12">
                    <table>
                        <tr>
                            <td style="width:120px">
                                <label>
                                    From Period
                                </label>
                            </td>
                            <td>
                                <div class="editor-field">
                                    @Html.TextBox("FrmPrd", "", new { @id = "FrmPrd", @class = "form-control input-sm date", @style = "width:145px" })
                                </div>
                            </td>

                            <td style="padding-left:10px; width:165px">
                                <label>
                                    To Period
                                </label>
                            </td>
                            <td>
                                <div class="editor-field">
                                    @Html.TextBox("ToPrd", "", new { @id = "ToPrd", @class = "form-control input-sm date", @style = "width:150px" })
                                </div>
                            </td>
                            <td style="padding-left:10px; width:10px"></td>
                            <td>
                                <div class="editor-field" style="width:85px">
                                    <label class="control-label" style="text-align:left"> @Html.CheckBox("UntilCancel", false, new { @id = "UntilCancel", @readonly = "readonly" }) Until Cancel</label>
                                </div>
                            </td>
                            <td style="padding-left:10px; width:60px"></td>
                            <td>
                                <div class="editor-field">
                                    @Html.TextBox("RefNo1", "", new { @id = "RefNo1", @placeholder = "Reference 1", @class = "form-control input-sm", @style = "width:250px" })
                                </div>
                            </td>
                            <td style="padding-left:10px; width:10px"></td>
                            <td>
                                <div class="editor-field">
                                    @Html.TextBox("RefNo2", "", new { @id = "RefNo2", @placeholder = "Reference 2", @class = "form-control input-sm", @style = "width:250px" })
                                </div>
                            </td>
                        </tr>
                        <tr  style="display:none">
                            <td style="padding-left:10px; width:10px"></td>
                            <td>
                                <div class="editor-field">
                                    @Html.TextBox("IsNew", "", new { @id = "IsNew", @placeholder = "IsNew", @class = "form-control input-sm", @style = "width:250px" })
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
<script type="text/javascript">

    $(function () {
        $("#MandateList").attr("disabled", "disabled");
        $("#UntilCancel").attr("readonly", true);
        $("#UntilCancel").attr("readonly", "readonly");
        console.log("sddsf" + $("#ImageName").val());

        if ($("#ImageName").val() == "") {
            $("#btnSave").attr("disabled", "disabled");
           // $("#btnEdit").attr("disabled", "disabled");
        }
        $("#BankName").val('');
        $("#BnkCd").ifsccode();
        $("#Mobile").mobileno();
        $("#Amt").numeric();
    });

    $("#Mobile").on("change", function () {
        if ($("#Mobile").val().length != 10) $("#Mobile").val('');
    });

    $("#BnkCd").on("change", function () {

        $.ajax({
            url: "/GenerateMandate/ValidateIFSC",
            type: "POST",
            data: "IFSCCode=" + $("#BnkCd").val(),
            dataType: 'json',
            success: function (result) {

                if (result.Status === 0) {
                    $("#BankName").val(result.Item.BnkName);
                }
                else {
                    $("#BankName").val('');
                    PopupError(result.Message);
                    return;
                }
            }
        });
    });

    $("#CrBrnCd").on("change", function () {
        $(this).val(pad($(this).val(), 4, '0'));
    });
    $("#CrGlCd").on("change", function () {
        $(this).val(pad($(this).val(), 4, '0'));
    });

    $("#UntilCancel").on("change", function () {
        if ($("#UntilCancel").is(':checked')) {
            $("#UntilCancel").prop('checked', true);
            $("#UntilCancel").val(true);
            $("#ToPrd").val('');
            $("#ToPrd").prop('disabled', true);

        }
        else {
            if ($("#UntilCancel").not(':checked')) {

                $("#UntilCancel").removeAttr('checked');
                $("#UntilCancel").val(true);
                /*$("#FrmPrd").val('');*/
                $("#FrmPrd").prop('disabled', false);
                $("#ToPrd").val('');
                $("#ToPrd").prop('disabled', false);
            }
        }
    });

    $("#CrAcNo").on("change", function () {
        $(this).val(pad($(this).val(), 7, '0'));
        $.ajax({
            url: "/GenerateMandate/ValidateCrAccount",
            type: "POST",
            data: "BrnCd=" + $("#CrBrnCd").val() + "&GlCd=" + $("#CrGlCd").val() + "&AcNo=" + $("#CrAcNo").val(),
            dataType: 'json',
            success: function (result) {
                console.log(result);
                $("#CrName").val("");
                $("#SpnsrBnkCd").val("");
                if (result.Status == 2) {

                    PopupError(result.Message);
                    return;
                }
                else {
                    $("#CrName").val(result.Item.Name);
                    $("#SpnsrBnkCd").val(result.Item.IFSCCode);
                }
            }
        });
    });
    function pad(number, length, char) {

        var str = '' + number;
        while (str.length < length) {
            str = char + str;
        }
        return str;
    }
    $("#btnUnAuth").on("click", function () {
        if ($("#btnUnAuth").val() !== "Cancel") {
            $("#MandateList").removeAttr("disabled");
            $("#btnSave").attr("disabled", "disabled");
            $("#btnEdit").attr("enable", "enable");
            $("#btnFetch").attr("disabled", "disabled");
        }
        else {
            $("#btnUnAuth").val('Un-Authenticated');
            $("#MandateList").attr("disabled", "disabled");
        }
    });


    $("#MandateList").on("click", function () {

        if ($(this).val() === null)
            return;

        $.ajax({
            url: "/GenerateMandate/GetMandateById",
            type: "POST",
            data: "Id=" + $(this).val(),
            dataType: 'json',

            success: function (result) {

                $("#scanImg").val("");
                $("#scanImg").attr("src", "");
                console.log("sdfdsf" + result.Item.ImgSrc);
                $("#scanImg").attr("src", result.Item.ImgSrc);
                $("#magnify-large").attr("src", result.Item.ImgSrc);
                bindFormData("#frmGenerateMandate", result.Item.Mandate);
                $("#btnAuth").removeAttr("disabled");
                $("#CrName").val(result.Item.Name);
                $("#AmtWord").val(result.Item.AmtInWord);
                $("#scanImg").magnify();
                $('input[type="select"]').prop("readonly", "readonly");
                $('input[type="dropdown"]').prop("readonly", "readonly");
                $('input[type="text"]').prop("readonly", "readonly");
                $("#btnUnAuth").val('Cancel');
            }
        });
    });

    $("#btnFetch").on("click", function () {
        $.ajax({
            url: "/GenerateMandate/FetchNextMandate",
            type: "POST",
            data: "Id=" + $("#ImageName").val(),
            dataType: 'json',
            //contentType: 'application/json',
            success: function (result) {
                //$divReserveList.html(result.partialView);
                PopupSuccess("Image Deleted Successfully!.");
                //$("#scanImg").attr("src", result.Item.GreyImg);
                $("#scanImg").magnify();
            }
        });
        setTimeout(function () { window.location.href = '@Url.Action("Index", "GenerateMandate")'; }, 3000)

    });
    $("#btnSave").on("click", function () {

        var formData = $("#frmGenerateMandate").serialize();
        $.ajax({
            url: "/GenerateMandate/Submit",
            type: "POST",
            data: formData,
            dataType: 'json',

            success: function (result) {
                if (result.Status === 0) {

                    PopupSuccess(result.Message);
                }
                else if (result.Status == 2) {
                    $('input[type="text"]').val('');
                    $("#scanImg").attr("src", "");
                    PopupError(result.Message);
                }

                setTimeout(function () {
                    window.location.href = '@Url.Action("Index", "GenerateMandate")';
                }, 5000)
            }
        });
    });

    $("#btnAuth").on("click", function () {
        $("#btnEdit").attr("disable", "disable");
        $.ajax({
            url: "/GenerateMandate/Authenticate",
            type: "POST",
            data: "Id=" + $("#MandateList").val(),
            dataType: 'json',

            success: function (result) {
                if (result.Status == 0) {
                    PopupSuccess(result.Message);
                    $('input[type="text"]').val('');
                    $("#scanImg").attr("src", "");
                }
                else {
                    PopupError(result.Message);
                }
            }
        });
    });

    $("#Amt").on("change", function () {
        var amt = parseFloat($(this).val());
        $(this).val(amt.toFixed(2));

        $.ajax({
            url: "/GenerateMandate/ValidateAmt",
            type: "POST",
            data: "amount=" + $(this).val(),
            dataType: 'json',

            success: function (result) {
                $("#AmtWord").val("Rs." + result.Item);
            }
        });
    });

    $("#btnEdit").on("click", function () {

        ($("#IsNew").val() == "False")
        $('input[type="text"]').prop("readonly", false);
        $('input[type="select"]').prop("readonly", false);
        $('input[type="dropdown"]').prop("readonly", false);
        $("#btnSave").attr("disabled", false);
    });
</script>
