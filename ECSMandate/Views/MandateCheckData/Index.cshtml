@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Upload", "MandateCheckData", FormMethod.Post, new { @class = "form-horizontal", @id = "frmMandateForm", role = "login" }))
{


    @*<div class="container-fluid">*@
        <!-- Page Heading -->
<div class="well">
    <h3 style="margin-top: -1%; font-weight: bold; font-size: 30px;"> Check Mandate</h3>
    <div class="row">
        <div class="col-lg-12">
            <!-- Circle Buttons -->
            <div class="row">
                <div class="col-md-1">
                    <label>Batch Size</label>
                </div>
                <div class="col-md-1">
                    <input type="text" class="form-control" value="10" id="batchSize" />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-success" id="btnReserve">Reserve Batch</button>
                </div>
                <div class="col-md-6" style="text-align:right">
                    <button type="button" class="btn bg-color-greenLight txt-color-white" id="btnShowReserve">Show Reserve Batch</button>
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-warning" id="btnUpdateBatch">Update Batch</button>
                </div>
            </div>
            <div id="divReserveList">

            </div>

        </div>

        @*</div>*@
    </div>
</div>
    @*<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">

                    <!-- Modal Header -->
