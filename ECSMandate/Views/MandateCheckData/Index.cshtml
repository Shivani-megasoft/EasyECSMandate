}


<script type="text/javascript">

    $divReserveList = $("#divReserveList");

    $("#btnReserve").click(function () {
        console.log("sdsdf");
        $.ajax({
            url: "/MandateCheckData/ReserveECS",
            type: "GET",
            data: { BatchSize: $("#batchSize").val() },
            dataType: 'json',
            contentType: 'application/json',
            success: function (result) {
                $divReserveList.html(result.partialView);
            }
        });

    });   

    $("#btnShowReserve").click(function () {
        $.ajax({
            url: "/MandateCheckData/ShowReserveECS",
            type: "GET",
            data: { BatchSize: $("#batchSize").val() },
            dataType: 'json',
            contentType: 'application/json',
            success: function (result) {
                $divReserveList.html(result.partialView);
            }
        });

    });   

    $('#dialog_simple_daily').dialog({
        autoOpen: false,
        width: 1100,
        resizable: false,
        modal: true,
        title: "Daily Position",
        buttons: [{
            html: "<i class='fa fa-times'></i>&nbsp; Close",
            "class": "btn btn-default",
            click: function () {
                $(this).dialog("close");
            }
        }]
    });

    $('#datatables').dataTable({
        "bDestroy": true,
        "bRetrieve": true,
        "sPaginationType": "bootstrap",
        "sDom": "R<'dt-top-row'Clf>r<'dt-wrapper't><'dt-row dt-bottom-row'<'row'<'col-sm-6'i><'col-sm-6 text-right'p>>",
        "fnInitComplete": function (oSettings, json) {
            $('.ColVis_Button').addClass('btn btn-default btn-sm').html('Columns <i class="icon-arrow-down"></i>');
        }
    });


</script>