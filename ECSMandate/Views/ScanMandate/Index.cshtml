            test = Ranger.SetGenericOption("OptionalDevices", "NeedFrontImage2", "true");

            test = Ranger.SetGenericOption("OptionalDevices", "NeedRearImage2", "false");

            //alert(itemCount);
            if (countTime === 0) {
                dateObj = new Date();
                countTime = dateObj.getTime();
            }

            if (itemCount >= 10) {
                dateObj = new Date();
                var currentTime = dateObj.getTime();
                var timeDifference = currentTime - countTime;
                var ratedSpeed = 60001 * (itemCount - 1) / timeDifference;
                var maxDPM = Ranger.GetTransportInfo("General", "MaximumDPM");
                if ("" == maxDPM) {
                    //document.getElementById('RatedSpeed').innerHTML = 'Running Speed: ' + Math.round(ratedSpeed);
                }
                else {
                    //document.getElementById('RatedSpeed').innerHTML = 'Running Speed: ' + Math.round(ratedSpeed) + '/' + maxDPM;
                }
            }

            //Fired when the item has been fed into the pocket

            var RangerSides = { TransportFront: 0, TransportRear: 1 };
            var RangerImageColorTypes = { ImageColorTypeBitonal: 0, ImageColorTypeGrayscale: 1, ImageColorTypeColor: 2 };

            // Note: SaveImageToFile() below is used to save gray scale images.  Please verify that 'NeedFrontImage2' and
