    function StartUpRanger() {

        $("#records").val('0');
        Ranger.wsUrl = document.getElementById("url").value;
        Ranger.StartUp();
        document.getElementById('ConnectionStatus').innerHTML = 'Attempting to Connect';
    }

    //Sets the Ranger Remote Version info in the html app
    //Receives a string as the "version" parameter
    function SetRangerRemoteVersion(version) {
        document.getElementById('RangerRemoteVersion').innerHTML = 'Ranger Remote Version: ' + version;
    }

    //If the image is not loadable, the onerror callback is called.
    function IsImageLoadable(URL) {
        var imageObj = new Image();

        //If onerror callback is called, changed PIC_WARNING text
        imageObj.onerror = function () {
            document.getElementById('PIC_WARNING').innerHTML = '<b>One or more of your requested grayscale images did not load properly.'
                + '<br>' + 'Please see the following link for more information:</b>' + '<br><br>'
                + 'Why are images not being displayed in the html browser application?'
                + '<br>' + '<a href="http://www.sbulletsupport.com/forum/index.php?topic=308.0">http://www.sbulletsupport.com/forum/index.php?topic=308.0</a>';
        }

        imageObj.src = URL;
    }

    Ranger = new MakeRanger();
    var images = document.getElementById('images');
    //Ranger.wsUrl = "ws://127.0.0.1:9002";//Is set in the StartUpRanger function
    Initialize();
    SetDefaults();
    function DemoStartFeed() {
        var feedtype = 0;
        var Value = document.getElementById('FeedMode').value;
        var FeedCount = document.getElementById('feedcount').value;
        if (Value == "MainHopper") {
            feedtype = 0;
        } else if (Value == "ManualDrop") {
            feedtype = 2;
        } else if (Value == "ManualID") {
            feedtype = 3;
        }
        Ranger.StartFeeding(feedtype, parseInt(FeedCount));
    }
    //Register the Ranger callbacks
    function Initialize() {
        document.getElementById("EnableImagingTrue").value = true;
        document.getElementById("EnableImagingFalse").value = true;
        document.getElementById("FrontBitonalTrue").value = true;
        document.getElementById("FrontBitonalFalse").value = true;
        document.getElementById("RearBitonalTrue").value = true;
        document.getElementById("RearBitonalFalse").value = true;
        document.getElementById("RearGrayscaleTrue").value = true;
        document.getElementById("RearGrayscaleFalse").value = true;


        Ranger.TransportNewState = function (newState, previousState) {
            // Transport new state, fired every time the State changes on the control
            // input params , are the new state and the previous state
            var RangerTransportStates = {
                TransportUnknownState: -1, TransportShutDown: 0, TransportStartingUp: 1,
                TransportChangeOptions: 2, TransportEnablingOptions: 3, TransportReadyToFeed: 4,
                TransportFeeding: 5, TransportExceptionInProgress: 6, TransportShuttingDown: 7
            };

            if (newState == RangerTransportStates.TransportShutDown) {
                document.getElementById('StartRanger').disabled = false;
                document.getElementById("url").disabled = false;
                document.getElementById('EnableRanger').disabled = true;
                //document.getElementById('EditOptions').disabled = true;
                document.getElementById('StopFeeding').disabled = true;
                document.getElementById('StartFeeding').disabled = true;
                //document.getElementById('ChangeOptions').disabled = true;
                document.getElementById('Shutdown').disabled = true;
                document.getElementById('UserInstructions').innerHTML = "Press 'Startup Ranger' to initialize the Ranger control"
            }
            if (newState == RangerTransportStates.TransportChangeOptions) {
                document.getElementById('StartRanger').disabled = true;
                document.getElementById("url").disabled = true;
                document.getElementById('StartFeeding').disabled = true;
                document.getElementById('EnableRanger').disabled = false;
                //document.getElementById('EditOptions').disabled = false;
                //document.getElementById('ChangeOptions').disabled = true;
                document.getElementById('Shutdown').disabled = false;
                document.getElementById("GetRangerLogging").disabled = false;
                document.getElementById("GetRangerServerLogging").disabled = false;
                document.getElementById('UserInstructions').innerHTML = "<b>Ranger Started</b> <br> Press 'Enable Options' to enable the current Ranger options and prepare to start feeding"
            }
            if (newState == RangerTransportStates.TransportReadyToFeed) {
                document.getElementById('EnableRanger').disabled = true;
                //document.getElementById('EditOptions').disabled = true;
                document.getElementById('StopFeeding').disabled = true;
                document.getElementById('StartFeeding').disabled = false;
                //document.getElementById('ChangeOptions').disabled = false;
                document.getElementById('Shutdown').disabled = false;
                document.getElementById('UserInstructions').innerHTML = "<b>Ready To Feed </b><br> Press 'Start Feeding' to start Ranger feeding checks from main hopper"
            }
            if (newState == RangerTransportStates.TransportFeeding) {
                document.getElementById('StartFeeding').disabled = true;
                //document.getElementById('ChangeOptions').disabled = true;
                document.getElementById('Shutdown').disabled = true;
                document.getElementById('StopFeeding').disabled = false;
                document.getElementById('UserInstructions').innerHTML = "<b>Feeding... </b><br> Press 'Stop Feeding' to stop Ranger from feeding checks"
            }
            getstatus();
        };

        Ranger.TransportStartingUp = function (previousState) {
            //alert(Ranger);
            //Get the Ranger version from the Ranger.js object and display it.
            document.getElementById('RangerVersion').innerHTML = 'Ranger Version: ' + Ranger.GetVersion();
            //Request the Ranger Remote version info from Ranger.js; Get value from RangerCallStatusCallback
            Ranger.GetInfo("Version", "RangerServer");
            getstatus();
        };

        Ranger.TransportShuttingDown = function (previousState) {
            //Update the Ranger version displayed.
            document.getElementById('RangerVersion').innerHTML = 'Ranger Version: N/A';

            //Update the Ranger Remote version displayed.
            document.getElementById('RangerRemoteVersion').innerHTML = 'Ranger Remote Version: N/A';

            //Update the scanner model displayed.
            document.getElementById('ScannerModel').innerHTML = 'Scanner Model: N/A';

            getstatus();
        };

        Ranger.TransportChangeOptions = function (previousState) {
            //
            //Get the scanner model, as contained in Ranger's TransportInfo.ini file,
            //from the Ranger.js object and display it. NOTE: should be ok to call
            //GetTransportInfo() here . . . see the Ranger Application Programmer's
            //Specification for details.
            //
            document.getElementById('ScannerModel').innerHTML = 'Scanner Model: ' + Ranger.GetTransportInfo("General", "Model");

            getstatus();
        };

        Ranger.TransportReadyToFeed = function (previousState) {
            // speed
            itemCount = 0;
            countTime = 0;
            //document.getElementById('RatedSpeed').innerHTML = 'Running Speed: N/A';

            //The TransportReadyToFeed event is fired when Ranger is ready to accept a
            //StartFeeding() call.

            //Set endorsement text if so configured.
            //if (document.getElementById("NeedRearEndorserTrue").checked == true)
            //    Ranger.SetFixedEndorseText(1, 1, document.getElementById("FixedLine1").value);

            /*
                  //
                  //Uncomment this code block to mimic an app that calls Ranger's
                  //StartFeeding() function from *within* the app's ReadyToFeedState
                  //event handler.
                  //
                  if(3 === previousState)
                  {
                    //Call StartFeeding() if and only if transitioning from the
                    //EnablingOptions state to the ReadyToFeed state.
                    Ranger.StartFeeding(0,0);
                  }
            */

            getstatus();
        };

        Ranger.TransportFeedingStopped = function (reason, itemsFed, itemsrequested) {
            getstatus();
        };

        Ranger.TransportItemInPocket = function (itemID) {
            // speed
            // itemCount += 1;

            test = Ranger.SetGenericOption("OptionalDevices", "NeedImaging", "true");

