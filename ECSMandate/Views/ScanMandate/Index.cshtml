    //Downlaod logs from GetRangerLogging() and GetRangerServerLogging()
    var DownloadLogs = function (filename, data, contenttype) {

        if (!data) {
            return;
        }

        if (!filename) {
            filename = 'RRConsole.txt';
        }

        var blob = new Blob([data], { type: 'text/json' }),
          e = document.createEvent('MouseEvents'),
          a = document.createElement('a');

        // detect IE/Edge
        if (document.documentMode || /Edge/.test(navigator.userAgent)) {
            // msSaveBlob() supported only by IE >= 10 and Edge
            var retVal = navigator.msSaveBlob(blob, filename);
        }
        else {
            a.download = filename;
            a.href = window.URL.createObjectURL(blob);
            a.dataset.downloadurl = ['text/json', a.download, a.href].join(':');
            e.initMouseEvent('click', true, false, window, 0, 0, 0, 0, 0, false, false, false, false, 0, null);
            a.dispatchEvent(e);
        }
    };

