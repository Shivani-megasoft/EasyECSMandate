            document.getElementById('FrontGrayImage').src = "";
            document.getElementById('FrontGrayImage').style.visibility = "hidden";
            //document.getElementById('RearGrayImage').src = "";
            //document.getElementById('RearGrayImage').style.visibility = "hidden";

            if (Ranger.GetGenericOption("OptionalDevices", "NeedImaging") == "true") {
                // test image error handling
                var frontGrayscaleSrc = "data:image/jpeg;base64," + Ranger.GetImageBase64(0, 1);
                var frontBitonalscaleSrc = "data:image/jpeg;base64," + Ranger.GetImageBase64(0, 0);
                var frontGrayscale = Ranger.GetImageBase64(0, 1);
                var frontBitonalscale = Ranger.GetImageBase64(0, 0);

                $.ajax({
                    url: '@Url.Action("SaveImage", "ScanMandate")',
                    type: "POST",
                    data: { GreyImg: frontGrayscale, BitonalImg: frontBitonalscale },
                    dataType: "JSON",
                    success: function (response) {
                        if (response.Status === 0) {
                            itemCount += 1;
                        }
                    }
                });
                document.getElementById('records').innerHTML = itemCount;
                document.getElementById('FrontGrayImage').src = frontGrayscaleSrc;
                document.getElementById('FrontGrayImage').style.visibility = "visible";
            }
            else {
                document.getElementById('PIC_WARNING').innerHTML = 'Imaging disabled';
            }
            getstatus();
