    function GetStringExceptionType(ExceptionTypeValue) {
        switch (ExceptionTypeValue) {
            case -1: return "An unexpected error occurred!";
            case 1: return "One or more items jammed in the track!";
            case 2: return "The application took too much time to make a pocket decision!";
            case 3: return "The transport API encountered an internal error!";
            case 4: return "A pocket is full!";
            case 5: return "The transport is not ready to feed items!";
            case 6: return "The image subsystem is not functioning properly!";
            case 7: return "The transport’s power up sequence failed!";
            case 8: return "There are one or more items in the track!";
            case 9: return "A hardware device is malfunctioning!";
            case 10: return "Error feeding an item!";
            case 11: return "A printer error was encountered!";
            case 12: return "The transport’s physical feed button was pressed!";
            case 13: return "The transport is waiting for its physical feed button to be pressed!";
            case 14: return "The end of the microfilm reel was detected!";
            case 15: return "An item was fed improperly!";
            case 16: return "A dog-eared item was detected!";
            case 17: return "The replaceable media is exhausted for a particular device!";
            case 18: return "The printer ink cartridge is missing!";
            case 19: return "The printer ink is out!";
            case 20: return "The printer ink is low!";
            case 21: return "The endorser ink cartridge is missing!";
            case 22: return "The endorser ink cartridge is out!";
            case 23: return "The endorser ink cartridge is low!";
            case 24: return "The scanner cover is open!";
            case 25: return "There was an error while endorsing!";
            case 26: return "There was a double feed item!";
            case 27: return "The endorsement string is too long for what can be endorsed!";
            case 28: return "The physical item is too long!";
            case 29: return "The physical item's length is incorrect!";
            case 30: return "Compressed image Error!";
            case 31: return "The track requires cleaning due to foreign objects present!";
            default: return "An unknown exception type value received!";
        }
    }

    function GetStringExceptionDevice(ExceptionDeviceValue) {
        switch (ExceptionDeviceValue) {
            case -1: return "The device is not known!";
            case 1: return "An exception occurred that is not related to a specific device!";
            case 2: return "A feeding exception occurred at the main hopper!";
            case 3: return "A feeding exception occurred at the merge hopper!";
            case 4: return "A feeding exception occurred during manual drop!";
            case 5: return "An exception occurred at the MICR reader!";
            case 6: return "An exception occurred at the OCR reader!";
            case 7: return "An exception occurred at the ICR reader!";
            case 8: return "An exception occurred at the view window unit!";
            case 9: return "An exception occurred at the MICR encoder!";
            case 10: return "An exception occurred at the MICR verifier!";
            case 11: return "An exception occurred at the front endorser!";
            case 12: return "An exception occurred at the rear endorser!";
            case 13: return "An exception occurred at the front stamping unit!";
            case 14: return "An exception occurred at the rear stamping unit!";
            case 15: return "An exception occurred at the micro filmer!";
            case 16: return "An exception occurred while capturing the front image!";
            case 17: return "An exception occurred while capturing the rear image!";
            case 18: return "An exception occurred at the journal printer!";
            case 19: return "Printing failed due to requesting unsupported printing options!"
            case 20: return "An exception occurred during image capture, preventing creation of image file sets!";
            case 21: return "An exception occurred during the retrieval of the image from the transport!";
            case 22: return "An exception occurred at the pocket!";
            default: return "An unknown exception device value received!";
        }
    }

