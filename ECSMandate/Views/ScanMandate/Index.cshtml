            //Clear PIC_WARNING
            document.getElementById('PIC_WARNING').innerHTML = "";

            document.getElementById('MICR').innerHTML = 'MICR: ' + Ranger.GetMicrText(1);

            //Here you could check to see if the images were saved, putting alternate
