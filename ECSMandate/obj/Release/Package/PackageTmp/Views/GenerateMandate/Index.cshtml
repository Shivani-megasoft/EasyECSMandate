                        </td>
                        <td style="padding-left: 30px; width: 80px">
                            <label> Debit Type </label>
                        </td>
                        <td>
                            @Html.DropDownList("DebitTyp", new SelectList(ViewBag.DrTypList, "Key", "Value"), new { @id = "DebitTyp", @class = "form-control input-sm", @style = "width:100px" })<i></i>
