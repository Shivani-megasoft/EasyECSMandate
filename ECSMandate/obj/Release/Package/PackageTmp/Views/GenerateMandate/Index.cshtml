                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

}
<script type="text/javascript">

    document.getElementById("ToPrd").disabled = true;
    document.getElementById("FrmPrd").disabled = true;
    document.getElementById("ExecDt").disabled = true;
    document.getElementById("UMRDt").disabled = true;
    document.getElementById("Dateofmndt").disabled = true;
    document.getElementById("AcTyp").disabled = true;
    document.getElementById("Freq").disabled = true;
    document.getElementById("Seq").disabled = true;
    document.getElementById("Category").disabled = true;
    document.getElementById("DebitTyp").disabled = true;
    document.getElementById("CrBrnCd").disabled = true;
    document.getElementById("CrGlCd").disabled = true;


    $(function () {
        $("#MandateList").attr("disabled", "disabled");
        $("#UntilCancel").attr("readOnly", true);
        $("#UntilCancel").attr("readOnly", "readOnly");
        console.log("sddsf" + $("#ImageName").val());
        $("#btnSave").attr("disabled", "disabled");
        $("#btnEdit").attr("disabled", "disabled");

        if ($("#ImageName").val() == "") {
            $("#btnSave").attr("disabled", "disabled");
        }
        $("#BankName").val('');
        $("#BnkCd").ifsccode();
        $("#Mobile").mobileno();
        $("#Amt").numeric();
    });

    $("#Dateofmndt").on("change", function () {
        var dateOfMandate1 = $("#Dateofmndt").val();
        var frmPrd1 = $("#FrmPrd").val();
        var date1Comparable = convertDateToComparableFormat(dateOfMandate1);
        var date2Comparable = convertDateToComparableFormat(frmPrd1);
        var dateOfMandate = new Date(date1Comparable);
        var frmPrd = new Date(date2Comparable);
        if ($("#FrmPrd").val().length === 0 || $("#FrmPrd").val() == null) {
            PopupError("Please fill form date first.!");
            $("#Dateofmndt").val('');
        }
        else if (dateOfMandate >= frmPrd) {
            PopupError("Date Of Mandate should be smaller than From date.!");
            $("#Dateofmndt").val('');
        }
    });

    function convertDateToComparableFormat(dateString) {
        var data = dateString.replace(/\//g, '')
        var day = data.slice(0, 2);
        var month = data.slice(2, 4);
        var year = data.slice(4, 8);
        return year + '-' + month + '-' + day;
    }

    $("#Mobile").on("change", function () {
        if ($("#Mobile").val().length != 10) $("#Mobile").val('');
    });




    $("#BnkCd").on("change", function () {

        $.ajax({
            url: "/GenerateMandate/ValidateIFSC",
            type: "POST",
            data: "IFSCCode=" + $("#BnkCd").val(),
            dataType: 'json',
            success: function (result) {
                if (result.Status === 0) {
                    $("#BankName").val(result.Item.BnkName);
                }
                else {
                    $("#BankName").val('');
                    PopupError(result.Message);
                    return;
                }
            }
        });
    });

    $("#CrBrnCd").on("change", function () {
        $(this).val(pad($(this).val(), 4, '0'));
    });
    $("#CrGlCd").on("change", function () {
        $(this).val(pad($(this).val(), 4, '0'));
    });

    $("#UntilCancel").on("change", function () {
        if ($("#UntilCancel").is(':checked')) {
            $("#UntilCancel").prop('checked', true);
            $("#UntilCancel").val(true);
            $("#ToPrd").val('');
            $("#ToPrd").prop('disabled', true);
        }
        else {
            if ($("#UntilCancel").not(':checked')) {
                $("#UntilCancel").removeAttr('checked');
                $("#UntilCancel").val(true);
                /*$("#FrmPrd").val('');*/
                $("#FrmPrd").prop('disabled', false);
                $("#ToPrd").val('');
                $("#ToPrd").prop('disabled', false);
            }
        }
    });

    $("#CrAcNo").on("change", function () {
        $(this).val(pad($(this).val(), 7, '0'));
        $.ajax({
            url: "/GenerateMandate/ValidateCrAccount",
            type: "POST",
            data: "BrnCd=" + $("#CrBrnCd").val() + "&GlCd=" + $("#CrGlCd").val() + "&AcNo=" + $("#CrAcNo").val(),
            dataType: 'json',
            success: function (result) {
                console.log(result);
                $("#CrName").val("");
                $("#SpnsrBnkCd").val("");
                if (result.Status == 2) {
                    PopupError(result.Message);
                    return;
                }
                else {
                    $("#CrName").val(result.Item.Name);
                    $("#SpnsrBnkCd").val(result.Item.IFSCCode);
                }
            }
        });
    });
    function pad(number, length, char) {
        var str = '' + number;
        while (str.length < length) {
            str = char + str;
        }
        return str;
    }
    $("#btnUnAuth").on("click", function () {
        if ($("#btnUnAuth").val() !== "Cancel") {
            $("#MandateList").removeAttr("disabled");
            $("#btnSave").attr("disabled", "disabled");
            $("#btnEdit").attr("disabled", false);
            $("#btnFetch").attr("disabled", true);

        }
        else {
            $("#btnUnAuth").val('Un-Authenticated');
            $("#MandateList").attr("disabled", "disabled");
        }
    });

    $("#MandateList").on("click", function () {

        if ($(this).val() === null)
            return;

        $.ajax({
            url: "/GenerateMandate/GetMandateById",
            type: "POST",
            data: "Id=" + $(this).val(),
            dataType: 'json',

            success: function (result) {
                debugger;
                $("#scanImg").val("");
                $("#scanImg").attr("src", "");
                console.log("sdfdsf" + result.Item.ImgSrc);
                $("#scanImg").attr("src", result.Item.ImgSrc);
       /*         $("#magnify-large").attr("src", result.Item.ImgSrc);*/
                bindFormData("#frmGenerateMandate", result.Item.Mandate);
                $("#btnAuth").removeAttr("disabled");
                $("#btnReject").removeAttr("disabled");
                $("#CrName").val(result.Item.Name);
                $("#AmtWord").val(result.Item.AmtInWord);
                $("#scanImg").magnify();
                $('input[type="select"]').prop("readOnly", "readOnly");
               // $('input[type="dropdown"]').prop("disabled", true);
                $('input[type="text"]').prop("readOnly", "readOnly");
                $("#btnUnAuth").val('Cancel');
                $("#Dateofmndt").val(result.Item.DateOfMandate);
                document.getElementById("AcTyp").disabled = true;
                document.getElementById("Freq").disabled = true;
                document.getElementById("Seq").disabled = true;
                document.getElementById("Category").disabled = true;
                document.getElementById("DebitTyp").disabled = true;

            }
        });
    });

    @*$("#btnFetch").on("click", function () {
        $.ajax({
            url: "/GenerateMandate/Delete",
            type: "POST",
            data: "Id=" + $("#Id").val(),
            dataType: 'json',
            //contentType: 'application/json',
            success: function (result) {
                //$divReserveList.html(result.partialView);
                PopupSuccess("Image Deleted Successfully!.");
                //$("#scanImg").attr("src", result.Item.GreyImg);
                $("#scanImg").magnify();
            }
        });
        setTimeout(function () { window.location.href = '@Url.Action("Index", "GenerateMandate")'; }, 3000)
    });*@

    $("#btnFetch").on("click", function () {
        if ($("#ImageName").val() == "") {
            $.ajax({
                url: "/GenerateMandate/DeleteUnauthMandate",
                type: "POST",
                data: "Id=" + $("#MandateList").val(),
                dataType: 'json',
                success: function (result) {
                    PopupSuccess("Mandate Deleted Successfully!.");
                    $("#scanImg").magnify();
                }
            });
        }
        else {
            $.ajax({
                url: "/GenerateMandate/FetchNextMandate",
                type: "POST",
                data: "Id=" + $("#ImageName").val(),
                dataType: 'json',
                success: function (result) {
                    PopupSuccess("Image Deleted Successfully!.");
                    $("#scanImg").magnify();
                }
            });
        }
        setTimeout(function () { window.location.href = '@Url.Action("Index", "GenerateMandate")'; }, 1000)
    });
    $("#btnSave").on("click", function () {

        if ($("#Dateofmndt").val() === "") {
            PopupError("Please enter Date of mandate.!");
            return;
        }

        var formData = $("#frmGenerateMandate").serialize() + "&Id=" + $("#Id").val();
        $.ajax({
            url: "/GenerateMandate/Submit",
            type: "POST",
            data: formData,
            dataType: 'json',

            success: function (result) {
                if (result.Status === 0) {
                    PopupSuccess(result.Message);
                }
                else if (result.Status == 2) {
                    $('input[type="text"]').val('');
                    $("#scanImg").attr("src", "");
                    PopupError(result.Message);
                }

                setTimeout(function () {
                    window.location.href = '@Url.Action("Index", "GenerateMandate")';
                }, 5000)
            }
        });
    });

    $("#btnAuth").on("click", function () {
        $("#btnEdit").attr("disable", "disable");
        $.ajax({
            url: "/GenerateMandate/Authenticate",
            type: "POST",
            data: "Id=" + $("#MandateList").val(),
            dataType: 'json',

            success: function (result) {
                if (result.Status == 0) {
                    PopupSuccess(result.Message);
                    $('input[type="text"]').val('');
                    $("#scanImg").attr("src", "");
                }
                else {
                    PopupError(result.Message);
                }
            }
        });
    });

    $("#btnReject").on("click", function () {

        $.ajax({
            url: "/GenerateMandate/RejectECSMandate",
            type: "POST",
            data: "Id=" + $("#Id").val(),
            dataType: 'json',
            success: function (result) {
                PopupSuccess(result.Message);
                //$("#scanImg").magnify();
                setTimeout(function () {
                    window.location.href = '@Url.Action("Index", "GenerateMandate")';
                }, 5000)
            }
        });
    });

    $("#Amt").on("change", function () {
        var amt = parseFloat($(this).val());
        $(this).val(amt.toFixed(2));

        $.ajax({
            url: "/GenerateMandate/ValidateAmt",
            type: "POST",
            data: "amount=" + $(this).val(),
            dataType: 'json',

            success: function (result) {
                $("#AmtWord").val("Rs." + result.Item);
            }
        });
    });

    $("#btnEdit").on("click", function () {

        ($("#IsNew").val() == "False")
        $('input[type="text"]').prop("readOnly", false);
        $('input[type="select"]').prop("readOnly", false);
        $('input[type="dropdown"]').prop("readOnly", false);
        $("#btnSave").attr("disabled", false);

