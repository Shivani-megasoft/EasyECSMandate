        document.getElementById("AcTyp").disabled = false;
        document.getElementById("Freq").disabled = false;
        document.getElementById("Seq").disabled = false;
        document.getElementById("Category").disabled = false;
        document.getElementById("DebitTyp").disabled = false;
    });

    $("#btnNew").on("click", function () {

        ($("#IsNew").val() == "True")
        $('input[type="text"]').val('');
        $('input[type="select"]').val('');
        $('input[type="dropdown"]').val('');
