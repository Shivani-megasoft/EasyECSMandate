
@{
    ViewBag.Title = "Index";
}

<style>
    .lbText {
        font-weight: bold;
    }

    .dropdown {
        border-style: solid;
        border-color: black;
        width: 170px;
        height: 30px;
    }

</style>

@using (Html.BeginForm("", "", FormMethod.Post, new { @class = "form-horizontal", @id = "frmCancelMandate", @style = "margin-top:30px" }))
{
    
<h3 style="margin-top: -1%; font-weight: bold; font-size: 30px;">Cancel Mandate</h3>
    <div class="row">
        <div class="col-md-5" style="padding-left:30px">
            <input class="btn btn-warning btn-sm" type="button" value="All Unauthenticated" id="btnUnAuth" />
            <input class="btn bg-color-blue txt-color-white" type="button" value="Authenticate" id="btnAuth" style="display:none" />
        </div>
        <div class="col-md-7">
            <p class="pull-right">
                <button type="button" id="btnSave" class="btn btn-success" disabled="disabled">Cancel Mandate</button>
            </p>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="well" style="padding:8px;height:440px">
            @Html.ListBox("MandateList", new SelectList(ViewBag.MandateList, "Id", "UMRNo"), new { @style = "height:100%;width:100%" })
        </div>
    </div>
    <div class="col-sm-10 well smart-form">
        <div class="row">
            <div class="col col-4">
                <label style="margin-right:46px">UMRN No</label> @Html.TextBox("UMRNo", "", new { @class = "input-sm", @Id = "umrNo", @style = "height: 15px" })
            </div>
            <div class="col col-4">
                <label style="margin-right:83px">Date</label> @Html.TextBox("UMRDt", "", new { @class = "input-sm date", @Id = "UMRDt", @style = "height: 15px" })
            </div>
            <div class="col col-4">
                <label style="margin-right:38px">Sponser IFSC</label> @Html.TextBox("SpnsrBnkCd", "", new { @class = "input-sm", @Id = "SpnsrBnkCd", @style = "height: 15px" })
            </div>
        </div><br />

        <div class="row">
            <div class="col col-4">
                <label style="margin-right:32px">Utility Code</label> @Html.TextBox("UtilityCd", "", new { @class = "input-sm", @Id = "UtilityCd", @style = "height: 15px" })
            </div>

            <div class="col col-4">
                <label style="margin-right:7px">Debitor A/c Type</label>@Html.DropDownList("AcTyp", new SelectList(ViewBag.AcTypList, "Key", "Value"), new { @class = "input-sm dropdown", @style = "height: 30px" })<i></i>
            </div>
            <div class="col col-4">
                <label style="margin-right:16px">Debitor Bank A/c</label> @Html.TextBox("AcNo", "", new { @class = "input-sm", @style = "height: 15px" })
            </div>
        </div><br />
        <div class="row">

            <div class="col col-4">
                <label style="margin-right:9px">Customer Bank</label> @Html.TextBox("BankName", "", new { @class = "input-sm", @style = "height: 15px" })
            </div>
            <div class="col col-4">
                <label style="margin-right:43px">Bank Code</label> @Html.TextBox("BnkCd", "", new { @class = "input-sm", @style = "height: 15px" })
            </div>
            <div class="col col-4">
                <label style="margin-right:77px">Amount</label>@Html.TextBox("Amt", "", new { @class = "input-sm", @style = "height: 15px" })<i></i>
            </div>
        </div><br />

        <div class="row">

            <div class="col col-4">
                <label style="margin-right:45px">Frequency</label>@Html.DropDownList("Freq", new SelectList(ViewBag.FrqList, "Key", "Value"), new { @class = "input-sm dropdown", @style = "height: 30px" })<i></i>
            </div>
            <div class="col col-4">
                <label style="margin-right:44px">Debit Type</label> @Html.DropDownList("DbTyp", new SelectList(ViewBag.DrTypList, "Key", "Value"), new { @class = "input-sm dropdown", @style = "height: 30px" })<i></i>
            </div>
            <div class="col col-4">
                <label style="margin-right:62px">Phone No</label> @Html.TextBox("PhoneNo", "", new { @Id = "PhoneNo", @class = "input-sm", @style = "height: 15px" })
            </div>
        </div><br />

        <div class="row">
            <div class="col col-4">
                <label style="margin-right:74px">E-Mail</label>@Html.TextBox("EMail", "", new { @Id = "EMail", @class = "input-sm", @style = "height: 15px" })
            </div>

            <div class="col col-4">
                <label style="margin-right:40px">Reference 1</label>@Html.TextBox("RefNo1", "", new { @class = "input-sm", @style = "height: 15px" })
            </div>
            <div class="col col-4">
                <label style="margin-right:50px">Reference 2</label>@Html.TextBox("RefNo2", "", new { @class = "input-sm", @style = "height: 15px" })
            </div>
        </div>
        <br />



        <div class="row">
            <div class="col col-4">
                <label style="margin-right:37px">From Period</label>@Html.TextBox("FrmPrd", "", new { @class = "input-sm date", @style = "height: 15px" })
            </div>
            <div class="col col-4">
                <label style="margin-right:58px">To Period</label>@Html.TextBox("ToPrd", "", new { @class = "input-sm date", @style = "height: 15px" })
            </div>
            @*<div class="col col-4">
                    <label>Corporate Name</label> @Html.TextBox("UtilityName", "", new { @class = "input-sm", @Id = "UtilityName", @style = "height: 15px" })
                </div>*@
        </div><br />
        <div class="alert alert-info alert-block">
            <h6 style="font-size:13px">Please select reason to cancel Mandate @Html.DropDownList("CancelReason", new SelectList(ViewBag.ReasonList, "RsnCd", "Name"), "--Select--", new { @class = "input-sm" })</h6>
        </div>
    </div>
}
<script type="text/javascript">

    $(function () {
        $('input[type=text]').attr("disabled", "disabled");
        $('select').attr("disabled", "disabled");
        $("#umrNo").removeAttr("disabled");

    });

    $("#btnUnAuth").click(function () {
        $("#MandateList").removeAttr("disabled");
    });

    $("#btnSave").click(function (e) {

        if ($("#UMRNo").val() === "") {
            PopupError("Please enter UMRNo");
            return;
        }
        $.ajax({
            url: "/CancelMandate/CancelMandate",
            type: "POST",
            data: "UMRN=" + $("#umrNo").val() + "&RtnRsn=" + $("#CancelReason").val(),
            dataType: 'json',
            //contentType: 'application/json',
            success: function (result) {
                PopupSuccess(result.Message);
                $("input[type=text]").val("");
                $("input[type=text]").removeAttr("disabled");
            }
        })
    })

    $("#btnAuth").click(function () {
        $.ajax({
            url: "/CancelMandate/AuthenticateCancel",
            type: "POST",
            data: "Id=" + $("#MandateList").val(),
            dataType: 'json',
            success: function (result) {
                //$divReserveList.html(result.partialView);
                if (result.Status == 0) {
                    PopupSuccess(result.Message);
                    location.reload();
                }
                else {
                    PopupError(result.Message);
                }
            }
        })
    });


    $("#umrNo").on("change", function () {
        $.ajax({
            url: "/CancelMandate/GetMandateByUMRN",
            type: "POST",
            data: "UMRN=" + $(this).val(),
            dataType: 'json',
            //contentType: 'application/json',
            success: function (result) {
                //$divReserveList.html(result.partialView);
                debugger;
                if (result.Status == 0) {
                    bindFormData("#frmCancelMandate", result.Item.Mandate);
                    $("#UMRDt").val(result.Item.UMRDt);
                    $("#PhoneNo").val(result.Item.Mandate.Mobile);
                    $("#EMail").val(result.Item.Mandate.EMail);
                    $("#CancelReason").empty();
                    $("#CancelReason").append("<option value=''>Select Reason</option>")
                    $.each(result.Item.RsnList, function (i, item) {
                        $("#CancelReason").append("<option value=" + item.RsnCd + ">" + item.Name + "</option>")
                    });
                    $("input[type=text]").attr("disabled", "disabled");
                    $("#umrnNo").removeAttr("disabled");
                    $("#btnSave").removeAttr("disabled");
                    $("#CancelReason").removeAttr("disabled");
                }
                else {
                    PopupError(result.Message);
                }
            }
        });
    });

    $("#lnkUnAuthAllECS").on("click", function () {
        $.ajax({
            type: "POST",
            url: "/CancelMandate/ShowAllUnAuth",
            data: "",
            dataType: "json",
            success: function (data, textStatus) {
                //log(data);
                $("#dvUnAuthECSListPanel").html(data.Item).dialog("open");

            }
        });

    });

    $("#MandateList").on("click", function () {
        $.ajax({
            url: "/CancelMandate/GetMandateById",
            type: "POST",
            data: "Id=" + $(this).val(),
            dataType: 'json',
            success: function (result) {
                // $divReserveList.html(result.partialView);
                if (result.Status == 0) {
                    bindFormData("#frmCancelMandate", result.Item);
                    $("#umrNo").val(result.Item.UMRNo);
                    $("#CancelReason").val(result.Item.RtnRsn);
                    $("input[type=text]").attr("disabled", "disabled");
                    //$("#umrnNo").removeAttr("disabled");
                    $("#btnAuth").show();

                }
                else {
                    PopupError(result.Message);
                    return;
                }

            }
        });
    });
</script>


