    function parseDate(dateString) {
        //console.log(this);
        var m = dateString.match(/^\/Date\((\d+)\)\/$/);
        var date = null;
        //alert(m);
        //m = 568704600000;
        //alert(new Date(568704600000));
        if (m) {
            date = new Date(parseInt(m[1]));
            //console.log("m:", date);
        }
        return formatJSONDate(date);
    }

    function FrmDate(dateString) {

        var F = dateString.match(/^\/Date\((\d+)\)\/$/);
        var date = null;
        if (F) {
            date = new Date(parseInt(F[1]));
        }
        return formatJSONDate(date);
    }

    function TDate(dateString) {
        debugger;
        //console.log(this);
        var T = dateString.match(/^\/Date\((\d+)\)\/$/);
        var date = null;
        if (T) {
            date = new Date(parseInt(T[1]));
        }
        return formatJSONDate(date);
    }

    function formatJSONDate(jsonDate) {
        console.log(jsonDate);
        if (null != jsonDate) {
            //var newDate = dateFormat(jsonDate.toLocaleDateString(), "dd/mm/yyyy");
            var newDate = pad(jsonDate.getDate(), 2, '0') + "/" + pad((jsonDate.getMonth() + 1), 2, '0') + "/" + jsonDate.getFullYear();
            return newDate;
        }
        else return "";
    }

    function pad(number, length, char) {

        var str = '' + number;
        while (str.length < length) {
            str = char + str;
        }
        return str;
    }
</script>


<script>
    var SignatureList = null;
    var SigCount = 0;
    function GetSignatures(brnCd, glCd, acNo) {
        $("#imgPrevious").removeAttr("tag").hide();
        $("#imgNext").removeAttr("tag").hide();
        //SignatureList = null;
        //SigCount = 0;
        $("#FrntSignImg").attr("src", "#");

        /* if (memNo == undefined) { memNo = ""; }*/

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetSignatureFiles", "Signature")',
            //url: "/Signature/GetSignatureFiles",
            //dataType: "json",
            dataType: 'json',
            data: "brnCd=" + brnCd + "&glCd=" + glCd + "&acNo=" + acNo + "&memNo=" + "",
            success: function (data, textStatus) {
                if (null != data.Item) {

                    if (null != data.Item.SignatureList && data.Item.SignatureList.length > 0) {
                        SignatureList = data.Item.SignatureList;
                        var sigModel = SignatureList[0];

                        $("#FrntSignImg").attr("src", sigModel.Src);
                        $("#magnifylarge").css("background", "url('/File/GetFileByName?file=" + sigModel.FileName + "')");
                        SigCount = parseInt(data.Item.SignatureList.length, 10);

                        if (SigCount > 1) {
                            $("#imgNext").attr("tag", 2).show();
                            $("#imgPrevious").attr("tag", 1).hide();
                        }
                    }
                }
                else {
                    PopupError(data.Message);
                }
            }
        });
    }

</script>